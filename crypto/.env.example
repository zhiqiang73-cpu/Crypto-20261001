# CoinGlass Open API v4 key (optional)
# 注意: 免费/低档套餐会对几乎所有 futures 端点返回 Upgrade plan。
# 系统默认已用 Binance+Bybit+OKX 免费接口替代, 不依赖此 key。
COINGLASS_API_KEY=

# DeepSeek (也可写到 runtime/secrets.json, 面板「配置」页可改)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Predict.fun mainnet (pred_sk_...)
PREDICT_FUN_API_KEY=
